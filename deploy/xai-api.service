[Unit]
Description=XAI FastAPI backend
After=network.target xai-mlflow.service
Requires=xai-mlflow.service

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=MLFLOW_TRACKING_URI=http://127.0.0.1:5000
Environment=MLFLOW_MODEL_ALIAS=production
ExecStart=__APP_DIR__/venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target

[Unit]
Description=XAI Streamlit UI
After=network.target xai-api.service

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=API_URL=http://127.0.0.1:8000
ExecStart=__APP_DIR__/venv/bin/streamlit run app.py \
  --server.port 8501 --server.address 127.0.0.1 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
